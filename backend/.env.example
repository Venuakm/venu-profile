# ---- Runtime ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:4000
SITE_URL=http://localhost:3010
CORS_ORIGINS=http://localhost:3010,http://localhost:3000

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=venu_profile

# ---- Auth secrets (generated - rotate before deploying) ----
JWT_SECRET=
REFRESH_TOKEN_SECRET=
COOKIE_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
MAX_LOGIN_ATTEMPTS=8
LOCKOUT_MINUTES=15

# ---- Owner account (used by npm run seed) ----
ADMIN_EMAIL=venuakkamgari@gmail.com
ADMIN_NAME=Venu Akkamgari
ADMIN_PASSWORD=

# ---- Mail (optional: leave blank and emails print to the console) ----
# For Gmail use an App Password, not your account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Venu Portfolio <no-reply@venuakkamgari.dev>
MAIL_TO=venuakkamgari@gmail.com

# ---- Cloudinary (required in production - host disks are ephemeral) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=venu-profile

# ---- Uploads (local fallback when Cloudinary is not configured) ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
